# إعدادات البيئة لسيرنا (React + SAIRNA API)
# انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة.

# بادئة عنوان الـ API. اتركه فارغًا للعمل عبر بروكسي Vite أثناء التطوير،
# وللإنتاج ضع عنوان الخادم الكامل: https://sairna.abdulrahman-hares.com
VITE_API_BASE_URL=

# عنوان السيرفر الذي يحوّل إليه Vite طلبات /api أثناء التطوير
VITE_API_PROXY_TARGET=
# اسم الهيدر وطريقة إرسال التوكن بعد تسجيل الدخول
VITE_AUTH_TOKEN_HEADER=Authorization
VITE_AUTH_TOKEN_PREFIX="Bearer "
